#!/usr/bin/make -f
# Debian rules for Ants Terminal.
#
# debhelper-compat 13 (declared in debian/control Build-Depends) means
# dh automatically drives configure / build / test / install / clean
# via the CMake buildsystem. Two steps are overridden: configure, to force
# Ninja (what upstream CI runs) and build the tests, and test, to pass
# ctest its arguments.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake --builddirectory=build

override_dh_auto_configure:
	dh_auto_configure -- \
		-G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DANTS_TESTS=ON

override_dh_auto_test:
	# The full ctest suite, Qt widget tests included. Twin of %check in
	# packaging/opensuse/ants-terminal.spec, which carries test settings this
	# recipe lacks; a test-environment fix made there belongs here too.
	dh_auto_test -- --output-on-failure
