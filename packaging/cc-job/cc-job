#!/bin/bash
# cc-job — run a long command OUTSIDE Ants Terminal, so relaunching Ants does
# not kill it, and read its output from any Claude Code session.
#
# Why this exists: everything Ants starts — Claude Code, its shell, anything
# that shell launches, even with nohup or setsid — lives in Ants' own systemd
# unit (app-ants-terminal@….service), and systemd stops that whole unit when
# Ants exits. `systemd-run --user` gives the job a unit of its own, so it
# survives. Output goes to a log file, which is what lets a later session read it.
set -euo pipefail

# Ships with Ants Terminal (ANTS-5629). A long job's log can grow without
# bound, so where the system drive is small, point CC_JOB_DIR (or a symlink
# at the default) at a data drive.
STATE="${CC_JOB_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/cc-job}"
mkdir -p "$STATE"

usage() {
    cat <<'EOF'
cc-job start <name> [--watch] -- <command> [args...]
                            run in the current directory; --watch also opens Konsole
cc-job status [<name>]      running / finished with exit code / stopped; no name lists
                            running jobs and the newest 20 others
cc-job status --all         the same for every job, by name
cc-job tail <name> [lines]  last lines of output (default 40)
cc-job wait <name> [--summary [lines]] [--grep <regex>]
                            block until the job ends, print its status line, then exit
                            with its exit code. --summary adds the last lines of output
                            (default 5); --grep adds the matching lines instead (the
                            last of them, with --summary)
cc-job watch <name>         open a Konsole window following the output live
cc-job stop <name>          stop the job
cc-job clean <name> [--force]
                            delete a finished job's log and records; refused
                            until `tail` has shown the log, unless --force
cc-job clean --mine [--force]
                            the same for every finished job this Claude Code
                            session started; names the jobs it kept

A pipeline or shell syntax needs a shell:  cc-job start build -- bash -c 'make 2>&1 | tee out'
Exported variables reach the job, except this session's own (CLAUDE*, ANTS_MCP_SOCKET and
the like). Unsetting one does not hide it from the job if the systemd --user manager has it.
Logs live in $XDG_STATE_HOME/cc-job/<name>.log (CC_JOB_DIR overrides)
Needs systemd --user; watch also needs Konsole.
EOF
}

die() { echo "cc-job: $*" >&2; exit 2; }
unit() { printf 'cc-job-%s.service' "$1"; }
checkname() {
    [[ ${1:-} =~ ^[A-Za-z0-9_.-]+$ ]] || die "a job name is letters, digits, dot, underscore or dash"
}
# Filled by snapshot_running for a status listing, where one call per job took
# minutes (ANTS-6354). Empty otherwise, so `wait` always asks afresh.
declare -A ACTIVE=()
USE_SNAPSHOT=0
running() {
    if ((USE_SNAPSHOT)); then
        [[ -n ${ACTIVE[cc-job-$1.service]:-} ]]
    else
        systemctl --user is-active --quiet "$(unit "$1")"
    fi
}
# On failure the listing asks per job: slow, but a running job never reads as
# finished.
snapshot_running() {
    local units u
    units=$(systemctl --user list-units 'cc-job-*' --state=active --no-legend --plain 2>/dev/null) ||
        return 0
    while read -r u _; do
        [[ -n $u ]] && ACTIVE[$u]=1
    done <<<"$units"
    USE_SNAPSHOT=1
}

watch_job() {
    local name=$1 log="$STATE/$1.log"
    [[ -f $log ]] || die "no job named '$name'"
    command -v konsole >/dev/null ||
        die "watch needs Konsole, which is not installed; 'cc-job tail $name' reads the log"
    # Its own unit too, so the window outlives an Ants relaunch. Closing the
    # window only stops the viewer, never the job.
    systemd-run --user --quiet --collect --unit="cc-job-watch-$name-$$" \
        konsole --hold -p tabtitle="cc-job: $name" -e tail -n +1 -F "$log"
}

# Write this shell's exported variables to file $1, mode 0600, as commands for
# bash to read. Left out are those describing this session and terminal rather
# than the job, so a job does not act as Claude Code's or Ants' own child.
write_vars() {
    local var
    (
        umask 077
        for var in $(compgen -e); do
            case $var in
                CLAUDE*|AI_AGENT|ANTS_CLAUDE_HOOK_SOCKET|ANTS_MCP_SOCKET|ANTS_OSC133_KEY) ;;
                BASHOPTS|SHELLOPTS|SHLVL|PWD|OLDPWD|_) ;;
                INVOCATION_ID|JOURNAL_STREAM|MANAGERPID|MANAGERPIDFDID|SYSTEMD_EXEC_PID) ;;
                MEMORY_PRESSURE_*|NOTIFY_SOCKET|LISTEN_*) ;;
                TERM|TERM_PROGRAM|TERM_PROGRAM_VERSION|COLORTERM|COLORFGBG|GPG_TTY) ;;
                *) printf 'export %s=%q\n' "$var" "${!var}" ;;
            esac
        done >"$1"
    )
}

start_job() {
    local name=${1:-}; checkname "$name"; shift
    local watch=0
    if [[ ${1:-} == --watch ]]; then watch=1; shift; fi
    if [[ ${1:-} == -- ]]; then shift; fi
    (($#)) || die "start needs a command after --"
    running "$name" && die "job '$name' is already running"
    systemctl --user reset-failed "$(unit "$name")" 2>/dev/null || true

    local log="$STATE/$name.log" rec="$STATE/$name.exit"
    rm -f "$rec" "$STATE/$name.read"
    : >"$log"
    {
        echo "cwd=$PWD"
        echo "started=$(date -Is)"
        echo "command=$(printf '%q ' "$@")"
        # The owner lets a session clean its own jobs and no one else's.
        if [[ -n ${CLAUDE_CODE_SESSION_ID:-} ]]; then echo "owner=$CLAUDE_CODE_SESSION_ID"; fi
    } >"$STATE/$name.info"

    # A unit starts from the user manager's environment, not this shell's. A
    # variable exported for the job must still reach it: dropped, a test job
    # selecting a scratch database falls back to the live one, with no error.
    # The values travel in a private file because --setenv would show them,
    # tokens included, in `ps` and in the unit's properties.
    local vars="$STATE/$name.env"
    write_vars "$vars"

    # The inner script is single-quoted on purpose: $1, $2, $3 and "$@" belong
    # to that inner bash, which receives log, rec, vars and the command as
    # arguments.
    # --expand-environment=no: otherwise systemd substitutes ${VAR} in the
    # command itself, so `exit ${PIPESTATUS[0]}` ran as `exit` and reported 0.
    # shellcheck disable=SC2016
    systemd-run --user --quiet --collect --unit="$(unit "$name")" --expand-environment=no \
        --working-directory="$PWD" --setenv=LANG="${LANG:-C.UTF-8}" \
        /bin/bash -c 'log=$1 rec=$2 vars=$3; shift 3; . "$vars"; rm -f "$vars"; unset vars; "$@" >>"$log" 2>&1; rc=$?; echo "$rc" >"$rec"; exit "$rc"' \
        cc-job "$log" "$rec" "$vars" "$@" || { local rc=$?; rm -f "$vars"; exit "$rc"; }
    echo "started '$name' — log: $log"
    if ((watch)); then watch_job "$name"; fi
}

status_one() {
    local name=$1 state
    if running "$name"; then
        state="running"
    elif [[ -f $STATE/$name.exit ]]; then
        state="finished, exit $(<"$STATE/$name.exit")"
    elif [[ -f $STATE/$name.log ]]; then
        state="stopped (ended before it could record an exit code)"
    else
        echo "$name: no such job"; return 1
    fi
    local started owner
    started=$(info_field "$name" started)
    owner=$(info_field "$name" owner)
    echo "$name: $state${started:+ — started $started}${owner:+ — session ${owner:0:8}} — log: $STATE/$name.log"
}

# The value of <key>= in a job's .info file, or nothing.
info_field() {
    local line
    [[ -f $STATE/$1.info ]] || return 0
    while IFS= read -r line; do
        if [[ $line == "$2="* ]]; then printf '%s' "${line#"$2"=}"; return 0; fi
    done <"$STATE/$1.info"
}

# Remove one finished job. Returns 1 if it is running, 2 if its output is unread
# and force is off; removes nothing in either case.
clean_one() {
    local name=$1 force=$2
    running "$name" && return 1
    # The log is the only copy of the output (CFG-0729: a clean before reading
    # it forced a re-run). Refuse until tail has shown it.
    if ((!force)) && [[ -s $STATE/$name.log && ! -e $STATE/$name.read ]]; then return 2; fi
    # Close any watch window first, or it reports the log vanishing.
    systemctl --user stop "cc-job-watch-$name-*" 2>/dev/null || true
    rm -f "$STATE/$name".{log,exit,info,read,env}
}

clean_cmd() {
    local force=0 rc=0
    if [[ ${1:-} != --mine ]]; then
        checkname "${1:-}"
        [[ ${2:-} == --force ]] && force=1
        clean_one "$1" "$force" || rc=$?
        case $rc in
            1) die "job '$1' is still running — stop it first" ;;
            2) die "job '$1' has output nobody has read — run 'cc-job tail $1' first, or clean --force" ;;
        esac
        echo "removed '$1'"; return 0
    fi
    [[ ${2:-} == --force ]] && force=1
    local me=${CLAUDE_CODE_SESSION_ID:-}
    [[ -n $me ]] || die "clean --mine needs CLAUDE_CODE_SESSION_ID, which only a Claude Code session sets"
    shopt -s nullglob
    local f name removed=0 kept=()
    snapshot_running
    # One grep picks this session's records. Reading each record in its own
    # subshell took seconds once thousands of old jobs had piled up.
    local mine
    mine=$(grep -lxF --include='*.info' -r -e "owner=$me" "$STATE" 2>/dev/null | sort) || true
    while IFS= read -r f; do
        [[ -n $f ]] || continue
        name=${f##*/}; name=${name%.info}
        rc=0; clean_one "$name" "$force" || rc=$?
        case $rc in
            0) removed=$((removed + 1)) ;;
            1) kept+=("$name (running)") ;;
            *) kept+=("$name (unread; 'cc-job tail $name' or --force)") ;;
        esac
    done <<<"$mine"
    echo "removed $removed of this session's jobs"
    local k
    for k in "${kept[@]}"; do echo "kept $k"; done
}

# Every job by name.
status_all() {
    shopt -s nullglob
    local f b found=0
    for f in "$STATE"/*.log; do
        if ((!found)); then snapshot_running; found=1; fi
        b=${f##*/}
        status_one "${b%.log}"
    done
    ((found)) || echo "no jobs"
}

# Running jobs, then the newest others. A finished job is kept, since its log is
# the only copy of its output, so the list has to bound itself.
status_recent() {
    local keep=20 names name shown=0 hidden=0
    mapfile -t names < <(find -H "$STATE" -maxdepth 1 -name '*.log' -printf '%T@ %f\n' |
                         sort -k1,1rn -k2,2 | sed 's/^[^ ]* //; s/\.log$//')
    if ((${#names[@]} == 0)); then echo "no jobs"; return 0; fi
    snapshot_running
    for name in "${names[@]}"; do
        if running "$name"; then status_one "$name"; fi
    done
    for name in "${names[@]}"; do
        if running "$name"; then continue; fi
        if ((shown < keep)); then
            status_one "$name"
            shown=$((shown + 1))
        else
            hidden=$((hidden + 1))
        fi
    done
    if ((hidden)); then
        echo "... $hidden older finished jobs not shown; 'cc-job status --all' lists them"
    fi
}

wait_job() {
    local name=${1:-}; checkname "$name"; shift
    # ANTS-5701: a few lines of the log, so a caller need not read all of it.
    local lines="" pattern=""
    while (($#)); do
        case $1 in
            --summary) lines=5
                       if [[ ${2:-} =~ ^[0-9]+$ ]]; then lines=$2; shift; fi ;;
            --grep)    [[ -n ${2:-} ]] || die "--grep needs a regular expression"
                       pattern=$2; shift ;;
            *)         die "wait takes --summary [lines] and --grep <regex>, not '$1'" ;;
        esac
        shift
    done
    local log="$STATE/$name.log"
    [[ -f $log ]] || die "no job named '$name'"
    while running "$name"; do sleep 2; done
    status_one "$name"
    if [[ -n $pattern ]]; then
        # grep exits 1 on no match, which is an answer here, not a failure.
        if [[ -n $lines ]]; then { grep -E -- "$pattern" "$log" || true; } | tail -n "$lines"
        else grep -E -- "$pattern" "$log" || true
        fi
        : >"$STATE/$name.read"
    elif [[ -n $lines ]]; then
        tail -n "$lines" "$log"; : >"$STATE/$name.read"
    fi
    [[ -f $STATE/$name.exit ]] || exit 1
    exit "$(<"$STATE/$name.exit")"
}

cmd=${1:-}; shift || true
case $cmd in
    start)  start_job "$@" ;;
    status)
        if [[ ${1:-} == --all ]]; then status_all
        elif (($#)); then checkname "$1"; status_one "$1"
        else status_recent
        fi ;;
    tail)   checkname "${1:-}"; [[ -f $STATE/$1.log ]] || die "no job named '$1'"
            tail -n "${2:-40}" "$STATE/$1.log"; : >"$STATE/$1.read" ;;
    wait)   wait_job "$@" ;;
    watch)  checkname "${1:-}"; watch_job "$1" ;;
    stop)   checkname "${1:-}"; systemctl --user stop "$(unit "$1")" && status_one "$1" ;;
    clean)  clean_cmd "$@" ;;
    ""|-h|--help|help) usage ;;
    *)      usage >&2; exit 2 ;;
esac
