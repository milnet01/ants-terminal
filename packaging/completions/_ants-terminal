#compdef ants-terminal
# zsh completion for ants-terminal(1).
#
# Source of truth: this file. Installed by CMake to
#   ${CMAKE_INSTALL_DATAROOTDIR}/zsh/site-functions/_ants-terminal
# which is on $fpath out of the box for system-wide zsh installs.
#
# CLI surface mirrored here is the same surface enumerated in the manpage and
# parsed in src/main.cpp via QCommandLineParser. Keep the three in sync.

_ants-terminal() {
    local -a args
    args=(
        '(- *)'{-h,--help}'[Display a short usage summary and exit]'
        '(- *)'{-v,--version}'[Print the program version and exit]'
        '(--quake --dropdown)'{--quake,--dropdown}'[Run in Quake / drop-down mode]'
        '--new-plugin[Scaffold a new Lua plugin and exit]:plugin name:'
        '--export-roadmaps[Export every roadmap-store project as JSONL and exit]:directory:_files -/'
        '--e2e[End-to-end test mode, for the tools/e2e harness]'
        '--remote[Send a remote-control command and exit]:command:'
        '--remote-socket[Override the remote-control socket path]:socket:_files'
        '--remote-tab[Target tab index, 0-based]:index:'
        '--remote-text[Text for send-text]:text:'
        '--remote-cwd[Working directory for new-tab or launch]:directory:_files -/'
        '--remote-command[Command for new-tab or launch to run]:command:'
        '--remote-title[Title for set-title]:title:'
        '--remote-lines[Trailing lines for get-text]:lines:'
        '--remote-json[Send a raw JSON command object]:json:'
    )
    _arguments -s -S $args
}

_ants-terminal "$@"
