// ANTS-1222 + ANTS-1394 — auto-generated by CMake.
// Do NOT edit. Regenerated automatically on every `cmake --build`
// invocation by the ants_build_info custom target (which runs
// cmake/GenerateBuildInfo.cmake). configure_file's copy_if_different
// means the file's mtime only advances when the embedded values
// actually changed (HH:MM minute, git SHA, build type) — ccache
// stays warm on intra-minute rebuilds.
//
// Surfaces build metadata in Help → About Ants Terminal so bug
// reports include enough context to triage "works for me / breaks
// for me" mismatches without asking the user a follow-up question.
//
// Tarball builds (no .git) get ANTS_BUILD_COMMIT="unknown".

#pragma once

#define ANTS_BUILD_DATE   "@ANTS_BUILD_DATE@"
#define ANTS_BUILD_TIME   "@ANTS_BUILD_TIME@"
#define ANTS_BUILD_TYPE   "@ANTS_BUILD_TYPE@"
#define ANTS_BUILD_COMMIT "@ANTS_BUILD_COMMIT@"
