// ANTS-1222 — auto-generated by CMake at configure time.
// Do NOT edit. Regenerate by re-running `cmake build/`.
//
// Surfaces build metadata in Help → About Ants Terminal so bug
// reports include enough context to triage "works for me / breaks
// for me" mismatches without asking the user a follow-up question.
//
// Configure-time semantics: the SHA / date reflect the last CMake
// configure step, not the current source state. Reconfigure to
// refresh between commits. Tarball builds (no .git) get
// ANTS_BUILD_COMMIT="unknown".

#pragma once

#define ANTS_BUILD_DATE   "@ANTS_BUILD_DATE@"
#define ANTS_BUILD_TYPE   "@ANTS_BUILD_TYPE@"
#define ANTS_BUILD_COMMIT "@ANTS_BUILD_COMMIT@"
