// ANTS-3582 — edit cmake/build_info_values.cpp.in, never the copy in
// build/generated/: cmake/GenerateBuildInfoValues.cmake regenerates that
// copy on every `cmake --build`. configure_file's copy_if_different keeps
// its mtime stable unless a value actually changed, so ONLY its object
// file recompiles.
//
// Definitions for the extern declarations in src/build_info.h. The
// `extern` + initializer form gives them external linkage (a plain
// namespace-scope `const char[]` would be internal in C++).

extern const char ANTS_BUILD_DATE[]   = "@ANTS_BUILD_DATE@";
extern const char ANTS_BUILD_TIME[]   = "@ANTS_BUILD_TIME@";
extern const char ANTS_BUILD_TYPE[]   = "@ANTS_BUILD_TYPE@";
extern const char ANTS_BUILD_COMMIT[] = "@ANTS_BUILD_COMMIT@";
