#!/usr/bin/env bash
# ANTS-3580 — pre-push CI gate. Runs the correctness test suite under CI's
# locale (C.UTF-8) against the warm build/ tree BEFORE the push — so a test
# failure is caught locally instead of coming back as a red CI email (the
# ANTS-3576 case: a narrow `ctest -R <subset>` passed locally while the full
# suite was red in CI). This is the FAST gate (see the ctest scope note below);
# the complete, exact CI mirror is `tools/ci-parity.sh --full`.
#
# Scope: the Release correctness suite, plus ci.yml's build-asan job when a
# sanitizer tree already exists locally AND is warm enough to build inside a
# caller's timeout (added after CI run 30587366963 went red on an ASan-only
# failure the Release suite structurally cannot see — see the build-asan leg
# below for why it is conditional, and ANTS-4118 for the cost gate). Still NOT covered: --lints
# (cppcheck / appstream / desktop / groff / version-drift / completions), the
# qt62-baseline compile guard, and e2e/perf under either build. Those run via
# `tools/ci-parity.sh --full`, which is the exact and complete CI mirror, before
# a release or when touching packaging- / e2e-sensitive code.
#
# Mirrors ci.yml's push `paths-ignore`: a docs-only push (ROADMAP / CHANGELOG /
# README / PLUGINS / LICENSE / docs/** / .roadmap-counter) skips CI, so the hook
# skips too and stays instant.
#
# Bypass (use sparingly): `git push --no-verify`.
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 0

zero="0000000000000000000000000000000000000000"

# ci.yml push paths-ignore — a push touching ONLY these skips CI.
docs_only_re='^(ROADMAP\.md|CHANGELOG\.md|README\.md|PLUGINS\.md|LICENSE|\.roadmap-counter|docs/)'

# Collect the set of commits being pushed (across all refs on stdin) and the
# files they touch. If we can't compute a precise range (new branch, no remote
# tracking), fall back to running the gate — never skip on uncertainty.
changed=""
run_gate=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [[ "$local_sha" == "$zero" ]] && continue          # branch delete — nothing to test
    if [[ "$remote_sha" == "$zero" ]]; then
        # New branch on the remote: diff against origin/main's merge-base if we
        # have it, else test unconditionally.
        base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
        if [[ -n "$base" ]]; then
            changed+=$'\n'"$(git diff --name-only "$base" "$local_sha")"
        else
            run_gate=1
        fi
    else
        changed+=$'\n'"$(git diff --name-only "$remote_sha" "$local_sha")"
    fi
done

changed="$(printf '%s\n' "$changed" | sed '/^$/d' | sort -u)"

if [[ "$run_gate" -eq 0 && -n "$changed" ]]; then
    # Positive capture (robust across grep builds — a bare `grep -qv` exit code
    # proved unreliable here): the non-doc files are the lines that do NOT match
    # docs_only_re. If there are none, the push is docs-only and CI would skip.
    non_doc="$(grep -vE "$docs_only_re" <<<"$changed" || true)"
    if [[ -z "$non_doc" ]]; then
        echo "pre-push: docs-only push (CI skips via paths-ignore) — no local gate."
        exit 0
    fi
fi

echo "pre-push: running the CI test gate locally (parallel, LC_ALL=C.UTF-8, e2e/perf excluded)…"
echo "          bypass with 'git push --no-verify'; complete mirror: tools/ci-parity.sh --full"

# Run the correctness suite against the EXISTING build/ — the hook does NOT
# build. Why: build_info.h (ANTS-1394) embeds the build MINUTE + git SHA and is
# #included by the two largest TUs (remotecontrol.cpp ~985 KB, claudeintegration
# .cpp ~689 KB), so any build crossing a minute boundary recompiles them
# (ccache-busted by the time macro) — minutes, not seconds. A multi-minute build
# under `git push` would guarantee the hook gets bypassed. The class this gate
# exists to catch (source-scrape drift — the ANTS-3576 case) reads the SOURCE at
# test time, so it is caught with NO rebuild; behavioral tests run against the
# binaries you already built while iterating.
#
# FAST-GATE scope: parallel (-j4) over the correctness labels, EXCLUDING e2e
# (drives a throwaway GUI instance — slow/unreliable in a detached hook) and perf
# (benchmarks that must not contend under -j). --timeout caps any hang (~22s).
# The COMPLETE, exact CI mirror (clean build + serial full suite + e2e + perf +
# build-asan + lints + qt62-baseline) is `tools/ci-parity.sh --full` — run it
# before a release or when touching sanitizer- / packaging- / e2e-sensitive code.
if [[ ! -f build/CTestTestfile.cmake ]]; then
    echo "pre-push: no build/ test tree found — build first" >&2
    echo "          (cmake --build build) or run tools/ci-parity.sh, then push." >&2
    echo "          (--no-verify to override.)" >&2
    exit 1
fi

if ! LC_ALL=C.UTF-8 ctest --test-dir build -j4 --output-on-failure \
        --timeout 180 -LE 'e2e|perf'; then
    echo >&2
    echo "pre-push: correctness suite FAILED under the CI locale — push blocked." >&2
    echo "          Fix the failures (or 'git push --no-verify' to override)." >&2
    echo "          NB: tests ran against your CURRENT build/ — if you changed" >&2
    echo "          behavior, rebuild (cmake --build build) and re-push." >&2
    exit 1
fi

# --- build-asan leg (ANTS-3761 follow-up) -----------------------------------
# The Release suite above cannot see a sanitizer-only failure, and one reached
# GitHub: CI run 30587366963 went red on an ASan-only RSS measurement while
# build-test stayed green. So mirror ci.yml's build-asan job too — but only
# against a sanitizer tree that ALREADY exists. Configuring one from cold is a
# 20-minute build, which is how a hook gets bypassed; an incremental build over
# a warm tree is the cost of the files you actually touched.
#
# Unlike the Release leg this one DOES build, because running a sanitized suite
# against stale binaries is a false pass rather than a cheap one. e2e and perf
# stay excluded for the same reasons as above (a detached hook cannot drive a
# GUI, and benchmarks must not contend). The exact, complete mirror — full
# sanitized ctest included — remains `tools/ci-parity.sh --full`.
#
# Opt out for one push with ANTS_PREPUSH_NO_ASAN=1.
asan_dir=""
for d in build-asan build-ci-parity-asan; do
    if [[ -f "$d/CMakeCache.txt" ]] &&
       grep -q '^ANTS_SANITIZERS:BOOL=ON$' "$d/CMakeCache.txt" 2>/dev/null; then
        asan_dir="$d"
        break
    fi
done

if [[ -n "${ANTS_PREPUSH_NO_ASAN:-}" ]]; then
    echo "pre-push: build-asan leg skipped (ANTS_PREPUSH_NO_ASAN set)."
elif [[ -z "$asan_dir" ]]; then
    echo "pre-push: ⊘ no sanitizer build tree — the build-asan gate did NOT run."
    echo "          CI still runs it. To cover it locally, once:"
    echo "            cmake -S . -B build-asan -G Ninja -DCMAKE_BUILD_TYPE=Debug -DANTS_SANITIZERS=ON"
    echo "          or run the complete mirror: tools/ci-parity.sh --full"
else
    # ANTS-4118 — cost gate. "A tree that already exists" is not the same as
    # "a tree that is warm": after a pull or a header touch the incremental
    # build is minutes long, and a caller with a command timeout (an agent
    # harness caps at 600 s) gets SIGTERMed mid-ninja. That costs twice — the
    # push fails, AND a killed ninja leaves the tree in the state this project
    # treats as untrustworthy. So measure the pending work and refuse a build
    # that will not fit, rather than starting one that may be killed. A warm
    # tree — the common case while iterating — is a handful of edges and runs.
    asan_marker="$asan_dir/.ants-prepush-interrupted"
    asan_max_edges="${ANTS_PREPUSH_ASAN_MAX_EDGES:-25}"

    # `ninja -n` lists the edges it WOULD run, in `[i/n] …` form, and costs
    # milliseconds. Unmeasurable (no ninja, no build.ninja) counts as unsafe:
    # an unmeasured build is exactly the one that gets killed. stderr is kept —
    # ninja reports a damaged deps file there, and that is a reading too.
    asan_dry=""
    asan_edges=""
    if command -v ninja >/dev/null 2>&1 && [[ -f "$asan_dir/build.ninja" ]]; then
        asan_dry="$(ninja -C "$asan_dir" -n 2>&1 || true)"
        asan_edges="$(grep -cE '^\[[0-9]+/[0-9]+\]' <<<"$asan_dry" || true)"
    fi

    if [[ -f "$asan_marker" ]]; then
        echo "pre-push: ⊘ build-asan gate SKIPPED — an earlier run was killed"
        echo "          mid-build in $asan_dir, so an incremental result over it"
        echo "          is a false pass, not a cheap one. Heal the tree and clear"
        echo "          the marker in one go:"
        echo "            cmake --build $asan_dir --clean-first && rm $asan_marker"
        echo "          CI's build-asan job still covers this push."
    elif [[ -z "$asan_edges" ]] || grep -q 'Re-running CMake' <<<"$asan_dry"; then
        # A pending regen hides every real edge behind it: the count reads 1
        # for what may be a full rebuild, which is what a changed CMakeLists.txt
        # produces. Unmeasurable, not cheap.
        echo "pre-push: ⊘ build-asan gate SKIPPED — cannot measure pending work"
        echo "          in $asan_dir (no ninja / no build.ninja, or a pending"
        echo "          CMake regen hiding the real edges), and an unmeasured"
        echo "          build is the one a caller timeout kills."
        echo "          Run it deliberately: tools/ci-parity.sh --full."
    elif (( asan_edges > asan_max_edges )); then
        echo "pre-push: ⊘ build-asan gate SKIPPED — $asan_dir has $asan_edges"
        echo "          pending build steps, over the $asan_max_edges cap"
        echo "          (ANTS_PREPUSH_ASAN_MAX_EDGES). That is a cold or stale"
        echo "          tree: minutes of build, which a caller timeout would kill"
        echo "          mid-ninja. Run it yourself (cmake --build $asan_dir) or"
        echo "          tools/ci-parity.sh --full; CI's build-asan job still"
        echo "          covers this push."
    else
        echo "pre-push: build-asan gate ($asan_edges pending build steps +"
        echo "          sanitized suite in $asan_dir) — expect a few minutes."
        echo "          Skip just this leg with ANTS_PREPUSH_NO_ASAN=1."
        # ANTS-4118 — ninja's "premature end of file; recovering" on the deps
        # log is reported, NOT gated on. Measured 2026-08-12: it survived a
        # full `--clean-first` rebuild of this repo's build-asan, so it is a
        # property of the on-disk log rather than a per-run signal, and a gate
        # keyed to it would never clear — permanently disabling the very leg
        # this cost gate exists to keep running. Recovery also errs toward
        # rebuilding more (a dropped dep record reads as dirty), not less.
        if grep -q 'premature end of file' <<<"$asan_dry"; then
            echo "          note: ninja is recovering a truncated deps log in"
            echo "          $asan_dir. Harmless (it rebuilds more, not less);"
            echo "          'cmake --build $asan_dir --clean-first' clears it."
        fi
        # If the caller's timeout kills us anyway, mark the tree so the NEXT
        # run refuses to trust an incremental build over a killed ninja.
        trap 'touch "$asan_marker"
              echo >&2
              echo "pre-push: interrupted during the sanitizer build — $asan_dir" >&2
              echo "          marked untrusted; the next run will say how to heal it." >&2
              exit 143' TERM INT
        if ! cmake --build "$asan_dir"; then
            echo >&2
            echo "pre-push: sanitizer build FAILED — push blocked." >&2
            echo "          ('git push --no-verify' to override.)" >&2
            exit 1
        fi
        if ! ASAN_OPTIONS=detect_leaks=0:halt_on_error=1 \
             UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1 \
             LC_ALL=C.UTF-8 ctest --test-dir "$asan_dir" -j2 --output-on-failure \
                                  --timeout 300 -LE 'e2e|perf'; then
            echo >&2
            echo "pre-push: sanitized suite FAILED — push blocked." >&2
            echo "          This is the class that reached CI as run 30587366963." >&2
            echo "          ('git push --no-verify' to override.)" >&2
            exit 1
        fi
        trap - TERM INT
    fi
fi

echo "pre-push: correctness suite green — push allowed."
exit 0
